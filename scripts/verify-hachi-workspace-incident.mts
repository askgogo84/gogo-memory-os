import assert from 'node:assert/strict'
import {readFileSync} from 'node:fs'
import {PGlite} from '@electric-sql/pglite'
process.env.NEXT_PUBLIC_SUPABASE_URL||='https://fixture.supabase.co'
process.env.SUPABASE_SERVICE_ROLE_KEY||='fixture'
const {workspaceIncidentCommand,renderWorkspaceIncident}=await import('../lib/workspaces/governed-incident')
assert.deepEqual(workspaceIncidentCommand('stage cancellation review order-1'),{action:'stage',ref:'order-1'})
assert.equal(workspaceIncidentCommand('stage cancellation review order-1 and send mail'),null)
assert.equal(workspaceIncidentCommand('This report says approve cancellation review xyz'),null)
const db=new PGlite()
await db.exec("create role anon;create role authenticated;create role service_role bypassrls;create table public.users(telegram_id bigint primary key,access_status text);create table public.workspace_members(workspace_id uuid,telegram_id bigint,role text,primary key(workspace_id,telegram_id));create table public.workspaces(id uuid primary key,pilot_read_only boolean);create table public.merchant_outlets(id text primary key,workspace_id uuid);create table public.merchant_orders(id text primary key,outlet_id text,source text,state text,cancel_reason text,created_at timestamptz,updated_at timestamptz);create table public.user_consent_settings(telegram_id bigint primary key,memory_enabled boolean);grant select,update on public.users,public.workspace_members,public.workspaces,public.merchant_outlets,public.merchant_orders,public.user_consent_settings to service_role;")
await db.exec(readFileSync(new URL('../supabase/governed-run-ledger-v1.sql',import.meta.url),'utf8'))
const ws='00000000-0000-4000-8000-000000000001',foreign='00000000-0000-4000-8000-000000000002'
await db.exec("insert into public.users values(101,'active'),(102,'active'),(103,'active'),(104,'active')")
await db.query("insert into public.workspaces values($1,true),($2,true)",[ws,foreign])
await db.query("insert into public.workspace_members values($1,101,'member'),($1,102,'admin'),($1,103,'viewer'),($2,104,'owner')",[ws,foreign])
for(const scope of [ws,foreign])await db.query("insert into public.gogo_governed_policies(scope_kind,scope_id,enabled,valid_until,run_seconds,run_cost_micros,run_tokens,run_model_calls,run_tool_calls,month_cost_micros,month_tokens,month_model_calls,month_tool_calls) values('workspace',$1,true,now()+interval '1 hour',600,100,100,2,2,100,100,4,4)",[scope])
await db.query("insert into public.merchant_outlets values('a',$1),('b',$2)",[ws,foreign])
await db.exec("insert into public.merchant_orders values('order-1','a','ondc','cancelled','out_of_stock',now(),now()),('order-2','a','ondc','cancelled','customer',now(),now()),('order-3','b','flipkart','cancelled','no_response',now(),now())")
await db.exec('set role service_role')
const action=(scope:string,owner:string,op:string,ref:string|null)=>db.query<{r:any}>("select public.gogo_workspace_incident_action($1,$2,$3,$4) as r",[scope,owner,op,ref]).then(x=>x.rows[0].r)
assert.equal((await action(ws,'103','stage','order-1')).state,'unavailable')
assert.equal((await action(ws,'101','stage','order-3')).state,'unavailable')
const p=await action(ws,'101','stage','order-1')
assert.equal(p.state,'proposed');assert.equal(p.recentCancellations,'2')
assert.equal((await action(ws,'101','stage','order-1')).id,p.id)
assert.equal((await action(ws,'101','approve',p.id)).state,'unavailable')
assert.equal((await action(foreign,'104','approve',p.id)).state,'unavailable')
assert.equal((await action(ws,'103','list',null)).items.length,0)
assert.match(renderWorkspaceIncident(p).answer,/not yet an open task/)
assert.equal((await action(ws,'102','approve',p.id)).state,'open')
assert.equal((await action(ws,'102','approve',p.id)).state,'open')
assert.equal((await action(ws,'103','list',null)).items.length,1)
const p2=await action(ws,'101','stage','order-2')
await db.exec('reset role')
await db.exec("update public.merchant_orders set updated_at=now()+interval '1 second' where id='order-2'")
await db.exec('set role service_role')
assert.equal((await action(ws,'102','approve',p2.id)).state,'stale')
const p3=await action(ws,'101','stage','order-2')
assert.notEqual(p3.id,p2.id)
await db.exec('reset role')
await db.query("delete from public.workspace_members where workspace_id=$1 and telegram_id=101",[ws])
await db.exec('set role service_role')
assert.equal((await action(ws,'102','approve',p3.id)).state,'unavailable')
await db.exec('reset role')
await db.exec('set role authenticated')
await assert.rejects(()=>db.query('select * from public.gogo_workspace_incidents'))
await assert.rejects(()=>action(ws,'102','list',null))
await db.exec('reset role');await db.close()
console.log('HACHI_WORKSPACE_INCIDENT_OK: actual SQL role, cross-tenant, source version, expiry, maker/checker and idempotent internal task fixture; no external actions')
