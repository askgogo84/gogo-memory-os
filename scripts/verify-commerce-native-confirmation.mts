import assert from 'node:assert/strict'
import {readFileSync} from 'node:fs'
const client=readFileSync('lib/commerce/mcp.ts','utf8')
const service=readFileSync('lib/commerce/native-order-confirmation.ts','utf8')
const api=readFileSync('app/api/commerce/purchases/[id]/native-confirm/route.ts','utf8')
const sql=readFileSync('supabase/migrations/20261116103000_commerce_native_confirmation_once.sql','utf8')
assert.match(client,/async confirmInstamartPaidOrder/)
assert.match(client,/name:'confirm_order'/)
assert.match(client,/COMMERCE_NATIVE_CONFIRMATION_ENABLED/)
assert.match(service,/payment_verified!==true/)
assert.match(service,/proof\.order_verified===true/)
assert.match(service,/proof\.paas_id!==attempt\.payment_paas_id/)
assert.match(service,/proof\.order_id!==attempt\.payment_order_id/)
assert.match(service,/get_orders/)
assert.match(service,/is\('confirmation_claimed_at',null\)/)
assert.match(service,/confirmation_outcome_unknown/)
assert.match(service,/confirmation_claimed_at:now/)
assert.doesNotMatch(service,/placeInstamartCheckout|confirmDuplicate/)
assert.match(api,/requireAgentMutationOrigin\(request\)/)
assert.match(api,/export async function POST/)
assert.doesNotMatch(api,/export async function GET/)
assert.match(sql,/confirmation_claimed_at/)
console.log('✅ provider-verified one-shot order confirmation guards passed')
