import assert from 'node:assert/strict'
// 17 Oct live scorecard (dashboard chat): the cases that failed, as exact messages.
process.env.ANTHROPIC_API_KEY ||= 'test'
const split = await import('../lib/splitwise/split-parser.ts')
assert.equal(split.parseSplitIntent('I spent 300 on coffee'), null, 'a personal expense is not a split')
assert.equal(split.parseSplitIntent('add expense 300 coffee'), null, 'a personal expense is not a split')
const four: any = split.parseSplitIntent('split 1200 among 4 people')
assert.deepEqual(four.members, ['Me', 'Person 2', 'Person 3', 'Person 4'], 'a head count, not a person called "4 People"')
assert.match(four.groupName, /^Split \d{1,2} \w{3} \d{1,2}:\d{2}/, 'a quick split is its own bill (with the time, so two on one day do not merge)')
const ravi: any = split.parseSplitIntent('add expense 900 dinner with Ravi and Sita')
assert.deepEqual(ravi.members, ['Me', 'Ravi', 'Sita'])
const cmp = await import('../lib/commerce/comparison-model.ts')
assert.deepEqual(cmp.parsePriceComparison('compare iPhone 17 256GB')?.providers, ['amazon', 'flipkart', 'croma', 'reliance'])
assert.deepEqual(cmp.parsePriceComparison('compare prices of Amul butter 500g')?.providers, ['zepto', 'blinkit', 'instamart'])
assert.equal(cmp.parsePriceComparison('compare iPhone 17 vs Pixel 10'), null, 'two products is a spec comparison')
assert.equal(cmp.parsePriceComparison('compare my options for health insurance'), null)
const { readFileSync } = await import('node:fs')
const watch = await import('../lib/agent/watch-command.ts')
const news: any = watch.parseWebWatchCommand('send me news about Tata Motors every morning')
assert.equal(news.query, 'Tata Motors news'); assert.equal(news.cadenceMinutes, 1440); assert.equal(news.requestedCadenceMinutes, 1440, 'the daily schedule survives normalisation')
const wsrc = readFileSync('lib/agent/watchers.ts', 'utf8')
assert.equal((wsrc.match(/Math\.max\(adaptiveWatcherCadence\(/g) || []).length, 2, 'adaptive checks never run more often than asked')
const parse = await import('../lib/bot/parse-claude-response.ts')
const p: any = parse.parseClaudeResponse('Got it, boss.\n\nSEARCH: cheapest flights Bengaluru Singapore')
assert.equal(p.type, 'search'); assert.equal(p.query, 'cheapest flights Bengaluru Singapore'); assert.doesNotMatch(p.replyText, /SEARCH:/)
const fi = readFileSync('lib/feature-intents.ts', 'utf8')
assert.match(fi, /answer\.split\(\/\\s\+\/\)\.length>5\|\|looksLikeNewCommand\(answer\)/, 'a new request is not an answer to "which calendar?"')
const legacy = readFileSync('lib/feature-intents-legacy.ts', 'utf8')
assert.match(legacy, /\^\(\?:i\\s\+\(\?:just\\s\+\)\?\)\?\(spent\|paid/, '"I spent 300 on coffee" is a personal expense log')
assert.match(legacy, /what did i spend/, '"what did I spend…" reads expenses, not the web')
assert.match(legacy, /telegramId: String\(extra\.telegramId\)/, 'web chat reads expenses by owner, not by phone')
console.log('scorecard 17 Oct ok')
// Re-run fixes (17 Oct 21:40): weekday dates, new requests are not answers, expense saves survive the schema.
const cal = await import('../lib/bot/handlers/calendar-actions.ts')
const mon: any = cal.weekdayDateParts('add a meeting with srini on monday at 5pm')
assert.ok(mon && mon.day >= 1, 'a weekday is a date')
assert.equal(cal.weekdayDateParts('my monthly report at 5pm'), null)
assert.equal(cal.weekdayDateParts('every monday at 9am'), null, 'a repeating weekday is not one date')
const pf = await import('../lib/bot/pending-followup.ts')
assert.equal(pf.looksLikeNewCommand('draft an email to goverdhan.md@gmail.com saying the review meeting is moved to Tuesday'), true)
assert.equal(pf.looksLikeNewCommand('write a LinkedIn post about launching AskGogo'), true)
const store = readFileSync('lib/bot/services/expense-storage.ts', 'utf8')
assert.match(store, /Could not find the '\(\[a-z_\]\+\)' column/, 'a missing column is dropped and the insert retried')
const expRoute = readFileSync('app/api/expenses/route.ts', 'utf8')
assert.match(expRoute, /if \(!saved\) return NextResponse\.json\(\{ reply: "I couldn't save that expense/, 'never "Logged" when nothing was saved')
console.log('re-run fixes ok')
// Overnight 18 Oct: list items, calorie questions.
const lists = await import('../lib/data/lists.ts')
assert.deepEqual(lists.splitListItems(['milk and eggs']), ['milk', 'eggs'])
assert.deepEqual(lists.splitListItems(['salt and pepper']), ['salt and pepper'])
assert.deepEqual(lists.splitListItems(['call mom and ask about dinner']), ['call mom and ask about dinner'])
assert.deepEqual(lists.splitListItems(['bread, butter, jam']), ['bread', 'butter', 'jam'])
const nut = await import('../lib/bot/nutrition-text.ts')
assert.equal(nut.isNutritionLogText('calories in 2 idlis and sambar'), false, 'a calorie question is answered, not logged')
assert.equal(nut.isNutritionLogText('how many calories in a dosa?'), false)
assert.equal(nut.isNutritionLogText('had 2 idlis and sambar for breakfast'), true)
console.log('overnight fixes ok')
const gm = await import('../lib/bot/handlers/gmail-read.ts')
const sum = gm.summariseInbox([
  {from: 'Air India Express <noreply@promo.airindiaexpress.com>', subject: 'Flat 10% off'},
  {from: 'Srini J <srini@example.com>', subject: 'Board deck review'},
  {from: 'Swiggy <no-reply@swiggy.in>', subject: 'Your order'},
])
assert.match(sum, /From people \(1\)\*\n1\. Srini J: Board deck review/); assert.match(sum, /Promotions and notifications \(2\)\*: Air India Express, Swiggy/)
const pm = readFileSync('lib/bot/process-message.ts', 'utf8')
assert.match(pm, /parseGmailReadFilter\(incomingText\),\/\\bsummar/, '"summarise my inbox" asks for a summary')
console.log('inbox summary ok')
const vault = readFileSync('lib/vault/credential-store.ts', 'utf8')
assert.match(vault, /const raw=String\(ownerId\|\|''\)\.trim\(\)\.split\(':'\)\[0\]/, 'a slot-check browser id resolves to its owner')
console.log('slot check owner ok')
const es = readFileSync('lib/bot/services/expense-storage.ts', 'utf8')
assert.match(es, /missing\[1\] === 'telegram_id' && !params\.whatsappId/, 'without a telegram_id column the row is kept by WhatsApp id')
assert.match(es, /run\('whatsapp_id', whatsappId\)/, 'and read back by WhatsApp id')
console.log('expenses without migration ok')
// Testing round 2 (18 Oct): weekday, goals, stop-watch, passport expiry.
const cl = readFileSync('lib/services/claude.ts', 'utf8')
assert.match(cl, /timeZone: 'Asia\/Kolkata', weekday: 'long'/, 'the prompt clock carries the IST weekday')
const wb = readFileSync('lib/agent/whatsapp-bridge.ts', 'utf8')
assert.match(wb, /async function tryListGoals/, '"show my goals" lists goals')
assert.match(readFileSync('lib/bot/process-message.ts', 'utf8'), /goalsReplyFor\(resolvedUser\.telegramId, listName\)/, 'a missing "goals" list falls back to goals')
assert.match(readFileSync('lib/agent/watch-command.ts', 'utf8'), /const GENERIC=new Set/, 'stop only matches on distinctive words')
const red = await import('../lib/bot/memory-redaction.ts')
assert.equal(red.redactSecretShapedText('my passport expires in March 2028'), 'my passport expires in March 2028')
assert.equal(red.redactSecretShapedText('passport number is Z1234567'), 'passport number [sensitive detail withheld]')
assert.equal(red.redactSecretShapedText('my password is hunter'), 'my password [sensitive detail withheld]')
console.log('testing round 2 ok')
const fci = await import('../lib/agent/food-comparison-intent.ts')
assert.equal(fci.isFoodComparisonRequest('best biryani places near Rajajinagar'), false, 'where-to-eat is not a delivery comparison')
assert.equal(fci.isFoodComparisonRequest('cheapest biryani near me on swiggy'), true)
assert.equal(fci.isFoodComparisonRequest('best biryani places near me for delivery'), true)
console.log('restaurant recommendation routing ok')
assert.match(readFileSync('lib/agent/general-planner.ts', 'utf8'), /in India: \$\{new Intl\.DateTimeFormat\('en-IN',\{timeZone:'Asia\/Kolkata',weekday:'long'/, 'the planner knows the IST weekday')
console.log('planner weekday ok')
assert.match(readFileSync('lib/services/claude.ts', 'utf8'), /Dates in saved context that are before today are history/, 'briefings leave past items out')
console.log('briefing past items ok')
assert.match(readFileSync('lib/bot/process-message.ts', 'utf8'), /I'll remember that \$\{rememberedForReply\(fact\)\}/, 'the confirmation speaks to the user')
const rfr = (readFileSync('lib/bot/process-message.ts', 'utf8').match(/export function rememberedForReply[\s\S]*?\n\}\n/) || [''])[0]
assert.ok(rfr.includes("my: 'your'"))
console.log('remember pronouns ok')
const wt = await import('../lib/bot/world-time.ts')
const at = new Date('2026-10-17T20:07:00Z')
assert.equal(wt.worldTimeReply('what is the time in New York now', at), 'Current time in New York: *4:07 PM* (Sat, 17 Oct, EDT)\nIn India it is 1:37 AM.')
assert.match(wt.worldTimeReply('what time is it in London?', at)!, /\*9:07 PM\*/)
assert.equal(wt.worldTimeReply('what time is it', at), null)
assert.equal(wt.worldTimeReply('what is the time in Narnia', at), null)
assert.match(readFileSync('lib/bot/process-message.ts', 'utf8'), /const worldTime = worldTimeReply\(incomingText\)/)
console.log('world time ok')
