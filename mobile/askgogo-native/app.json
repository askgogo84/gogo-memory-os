{
  "expo": {
    "name": "AskGogo",
    "slug": "askgogo-native",
    "scheme": "askgogo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F1E9",
    "splash": {
      "backgroundColor": "#F7F1E9",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.askgogo.app",
      "backgroundColor": "#F7F1E9"
    },
    "android": {
      "package": "in.askgogo.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E9"
      }
    },
    "plugins": ["expo-router", "expo-system-ui"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://app.askgogo.in"
    }
  }
}
